{
  "name": "@payments-platform/root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm run --parallel --filter './apps/*' dev",
    "build": "turbo run build",
    "test": "turbo run test",
